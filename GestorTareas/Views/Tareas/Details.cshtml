@model GestorTareas.Models.Tarea

@{
    ViewData["Title"] = "Detalle de tarea";
}

<h1>@Model.Titulo</h1>

<dl class="row">
    <dt class="col-sm-3">Descripción</dt>
    <dd class="col-sm-9">@(Model.Descripcion ?? "Sin descripción")</dd>

    <dt class="col-sm-3">Materia</dt>
    <dd class="col-sm-9">@Model.Materia</dd>

    <dt class="col-sm-3">Fecha límite</dt>
    <dd class="col-sm-9">@Model.FechaLimite</dd>

    <dt class="col-sm-3">Prioridad</dt>
    <dd class="col-sm-9">@Model.Prioridad</dd>

    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@(Model.Completada ? "Completada" : "Pendiente")</dd>
</dl>

<a asp-action="Index">Volver a la lista</a>